<Window x:Class="L.r._3_4_.NET.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:L.r._3_4_.NET"
        mc:Ignorable="d"
        Title="Система замовлень" Height="950" Width="800"
        Background="#FFE3F2FD">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Background" Value="DodgerBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Усі поля вводу -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <!-- Усі рамки з заголовком -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

    </Window.Resources>

    <StackPanel Margin="10">

        <!-- Створення замовлення -->
        <GroupBox Header="Нове замовлення">
            <StackPanel Margin="10,0,10,0">

                <Label Content="Тип замовлення:"/>
                <ComboBox x:Name="OrderTypeComboBox" Width="250" HorizontalAlignment="Left"
                          SelectionChanged="OrderTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Інтернет-замовлення"/>
                    <ComboBoxItem Content="Замовлення в магазині"/>
                    <ComboBoxItem Content="Корпоративне замовлення"/>
                </ComboBox>

                <!-- Поля тільки для інтернет-замовлення -->
                <StackPanel x:Name="OnlineFields">
                    <Label Content="Спосіб доставки:"/>
                    <ComboBox x:Name="DeliveryComboBox" Width="250" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Поля тільки для замовлення в магазині -->
                <StackPanel x:Name="StoreFields" Visibility="Collapsed">

                    <!-- Рядок: Ім'я клієнта (ліворуч) та вибір картки (праворуч) по 50% -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ліва половина: Ім'я клієнта -->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <Label Content="Ім'я клієнта:" Padding="0,0,0,2"/>
                            <TextBox x:Name="CustomerNameTextBox"/>
                        </StackPanel>

                        <!-- Права половина: Картка лояльності (Радіобатони) -->
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <Label Content="Картка лояльності:" Padding="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <RadioButton x:Name="NoCardRadio" Content="Немає" Checked="CardRadio_Changed"/>
                                <RadioButton x:Name="HasCardRadio" Content="Є" Margin="20,0,0,0" Checked="CardRadio_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- З'являється нижче на всю ширину, лише коли обрано «Є» -->
                    <StackPanel x:Name="PhonePanel" Visibility="Collapsed" Margin="0,5,0,0">
                        <Label Content="Номер телефону (для знижки):" Padding="0,0,0,2"/>
                        <TextBox x:Name="LoyaltyPhoneTextBox"/>
                    </StackPanel>
                </StackPanel>

                <!-- Поля тільки для корпоративного замовлення (Назва компанії та ЄДРПОУ по 50%) -->
                <StackPanel x:Name="CorporateFields" Visibility="Collapsed">
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ліва половина: Назва компанії -->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <Label Content="Назва компанії:" Padding="0,0,0,2"/>
                            <TextBox x:Name="CompanyNameTextBox"/>
                        </StackPanel>

                        <!-- Права половина: ЄДРПОУ -->
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <Label Content="ЄДРПОУ (8 цифр):" Padding="0,0,0,2"/>
                            <TextBox x:Name="EdrpouTextBox"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Поля для обох типів -->
                <!-- Рядок для товару та ціни в одній панелі -->
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ліва колонка: Назва товару -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Label Content="Назва товару:" Padding="0,0,0,2"/>
                        <TextBox x:Name="ItemNameTextBox"/>
                    </StackPanel>

                    <!-- Права колонка: Ціна товару -->
                    <StackPanel Grid.Column="1">
                        <Label Content="Ціна товару:" Padding="0,0,0,2"/>
                        <TextBox x:Name="PriceTextBox"/>
                    </StackPanel>
                </Grid>

                <Button x:Name="AddItemButton" Content="Додати товар"
                        Click="AddItemButton_Click"/>

                <Label Content="Товари в замовленні:"/>
                <ListBox x:Name="CartListBox" Height="60"/>

                <Button x:Name="CreateOrderButton" Content="Створити замовлення"
                        Click="CreateOrderButton_Click"/>

            </StackPanel>
        </GroupBox>

        <!-- Список створених замовлень -->
        <GroupBox Header="Список замовлень">
            <ListBox x:Name="OrdersListBox" Height="200"/>
        </GroupBox>

        <!-- Аналітика -->
        <GroupBox Header="Загальні вартості різних видів замовлень">
            <StackPanel Margin="5">

                <!-- Рядок 1: три типи поруч -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Інтернет-замовлення: " FontWeight="Bold"/>
                    <TextBlock x:Name="OnlineTotalTextBlock" Text="0,00 ₴" Margin="0,0,30,0"/>

                    <TextBlock Text="Замовлення в магазині: " FontWeight="Bold"/>
                    <TextBlock x:Name="StoreTotalTextBlock" Text="0,00 ₴" Margin="0,0,30,0"/>

                    <TextBlock Text="Корпоративні: " FontWeight="Bold"/>
                    <TextBlock x:Name="CorporateTotalTextBlock" Text="0,00 ₴"/>
                </StackPanel>

                <!-- Рядок 2: усі замовлення по центру -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="Усі замовлення разом: " FontWeight="Bold"/>
                    <TextBlock x:Name="AllTotalTextBlock" Text="0,00 ₴"/>
                </StackPanel>

                <!-- Рядок 3: сума знижок (через інтерфейс IDiscountable) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="Сума знижок: " FontWeight="Bold"/>
                    <TextBlock x:Name="DiscountTotalTextBlock" Text="0,00 ₴"/>
                </StackPanel>

            </StackPanel>
        </GroupBox>
    </StackPanel>
</Window>